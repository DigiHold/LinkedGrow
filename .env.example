# LinkedGrow self hosted. Copy to .env and set the three values. Everything else is configured in the setup wizard.

# The address people will open in their browser, without a trailing slash.
# http://localhost:3000 for a first try, https://linkedgrow.example.com behind your reverse proxy.
APP_URL=http://localhost:3000

# Session signing secret. Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me

# Encrypts every stored credential (LinkedIn passwords, API keys, proxy logins). Exactly 64 hex characters:  openssl rand -hex 32
# Never change it after the first start: everything encrypted with the old value becomes unreadable.
ENCRYPTION_KEY=change-me

# Optional. Google sign in: set both and NEXT_PUBLIC_GOOGLE_SIGNIN=1.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_SIGNIN=0

# Optional. Concurrent LinkedIn browsers the worker may open. 2 fits 4 GB of RAM; 12 needs 16 GB.
WORKER_SLOTS=2
