# LinkedGrow Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# NextAuth Authentication
# ===================
AUTH_SECRET=your-auth-secret-here
AUTH_URL=https://linkedgrow.ai

# ===================
# Database (Turso - SQLite at the edge)
# ===================
# Local development uses SQLite file at ./linkedgrow.db (no env needed)
# For production, get these from Turso dashboard
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ===================
# AI API Keys (User-provided via Settings, stored encrypted)
# ===================
# Users will add their own keys in the Settings page
# These are stored in the database, encrypted

# ===================
# LinkedIn OAuth (Required for publishing)
# ===================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://linkedgrow.ai/api/linkedin/callback

# ===================
# Stripe Payments
# ===================
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_BUSINESS_PRICE_ID=price_xxxxx

# ===================
# Cloudflare R2 Storage (for media files)
# ===================
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=linkedgrow-media
# Optional: Custom domain for R2 (e.g., https://media.linkedgrow.ai)
R2_PUBLIC_URL=

# ===================
# QStash (Upstash - for exact-time post scheduling)
# ===================
# Get these from Upstash Console > QStash
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# ===================
# Search Engine Indexing
# ===================
# IndexNow - instant notification to Bing, Yandex, Naver, Seznam (free)
INDEXNOW_KEY=your-indexnow-key-here
# Google Indexing API - fast Google crawling (free, 200 URLs/day)
# Paste the ENTIRE JSON content of your Google Cloud service account key file
# Get it: Google Cloud Console > APIs > Credentials > Service Account > Keys > JSON
# Then add the service account email as Owner in Google Search Console
GOOGLE_INDEXING_CREDENTIALS=

# ===================
# App Configuration
# ===================
NEXT_PUBLIC_APP_URL=https://linkedgrow.ai
NEXT_PUBLIC_APP_NAME=LinkedGrow
# Set to "true" to show pre-launch landing page instead of full site
NEXT_PUBLIC_PRELAUNCH_MODE=true

# ===================
# Analytics & Tracking (Cookie Consent Required)
# ===================
# Google Tag Manager - manages Google tags (GA4, Google Ads)
# GTM loads on every page with Consent Mode V2
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Non-Google Tracking (loaded dynamically based on consent)
# Meta/Facebook Pixel - get from Meta Events Manager
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
# Contentsquare (formerly Hotjar) - 13-char Tag ID from your tracking code
# Example: If your code is https://t.contentsquare.net/uxa/c6827c21cc7a3.js
# Then your Tag ID is: c6827c21cc7a3
NEXT_PUBLIC_CONTENTSQUARE_TAG_ID=

# LinkedIn Insight Tag - Partner ID for LinkedIn Ads tracking
# Get from LinkedIn Campaign Manager > Analyze > Insight Tag
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
