# LinkedGrow self hosted. You do not need this file.
#
# `docker compose up -d` in a folder holding only docker-compose.yml is the
# whole install. The app writes its own AUTH_SECRET and ENCRYPTION_KEY into the
# config volume on the first start, answers on whatever address you open, and
# asks for everything else in the setup wizard at first login.
#
# Copy this to .env next to docker-compose.yml only when you want one of the
# settings below. Every one of them is optional.

# Concurrent LinkedIn browsers the worker may open. 2 fits 4 GB of RAM; 12 needs 16 GB.
WORKER_SLOTS=2

# The published image tag to run: latest, a release like v1.0.0, or sha-1a2b3c4.
LINKEDGROW_VERSION=latest

# Which address the app port is published on, and which port. 0.0.0.0 reaches
# the network, 127.0.0.1 keeps it behind a reverse proxy on this machine.
APP_BIND=0.0.0.0
APP_PORT=3000

# Your domain, and the profile that runs the built in Caddy in front of the app.
# Both are needed for https, along with the Caddyfile next to this file.
DOMAIN=
COMPOSE_PROFILES=

# The address people type, pinned. Leave it empty and the instance answers on
# whatever address the request arrived on, which is what most installs want.
# APP_URL=https://linkedgrow.example.com

# The 2 secrets, only when you are restoring a backup and have to put the
# original values back. Set them and they win over the generated file, and
# ENCRYPTION_KEY must be the exact one the backup was written with or every
# stored credential in it stays unreadable.
# AUTH_SECRET=
# ENCRYPTION_KEY=
