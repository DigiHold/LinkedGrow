# LinkedGrow Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# NextAuth Authentication
# ===================
AUTH_SECRET=your-auth-secret-here
AUTH_URL=https://linkedgrow.ai

# ===================
# Database (Turso - SQLite at the edge)
# ===================
# Local development uses SQLite file at ./linkedgrow.db (no env needed)
# For production, get these from Turso dashboard
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ===================
# AI API Keys (User-provided via Settings, stored encrypted)
# ===================
# Users will add their own keys in the Settings page
# These are stored in the database, encrypted

# ===================
# LinkedIn OAuth (Required for publishing)
# ===================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://linkedgrow.ai/api/linkedin/callback

# ===================
# Stripe Payments
# ===================
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_BUSINESS_PRICE_ID=price_xxxxx

# ===================
# Cloudflare R2 Storage (for media files)
# ===================
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=linkedgrow-media
# Optional: Custom domain for R2 (e.g., https://media.linkedgrow.ai)
R2_PUBLIC_URL=

# ===================
# App Configuration
# ===================
NEXT_PUBLIC_APP_URL=https://linkedgrow.ai
NEXT_PUBLIC_APP_NAME=LinkedGrow
# Set to "true" to show pre-launch landing page instead of full site
NEXT_PUBLIC_PRELAUNCH_MODE=true

# ===================
# Analytics & Tracking (Cookie Consent Required)
# ===================
# Google Tag Manager (contains GA4, Google Ads, etc.)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Meta/Facebook Pixel (optional - can also be loaded via GTM)
NEXT_PUBLIC_META_PIXEL_ID=
# Hotjar Analytics (optional)
NEXT_PUBLIC_HOTJAR_ID=
