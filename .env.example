# LinkedGrow Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# Clerk Authentication
# ===================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===================
# Database (Cloudflare D1)
# ===================
# These are automatically injected by Cloudflare Workers
# For local development, use wrangler d1 execute

# ===================
# AI API Keys (User-provided via Settings, stored encrypted)
# ===================
# Users will add their own keys in the Settings page
# These are stored in the database, not environment variables

# ===================
# LinkedIn OAuth (Optional - for direct publishing)
# ===================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://linkedgrow.ai/api/linkedin/callback

# ===================
# App Configuration
# ===================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LinkedGrow
