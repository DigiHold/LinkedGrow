# The same database the dashboard uses. In Docker Compose this is http://db:8080 with no token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Must be the same 64 hex characters as the app's ENCRYPTION_KEY. Everything stored encrypted
# (LinkedIn passwords, 2FA secrets, API keys, proxy credentials) is unreadable with a different one.
ENCRYPTION_KEY=

# "production" refuses to run any agent that has no dedicated address allocated.
WORKER_ENV=production

# self-hosted (default) reads the AI key and the proxy supplier key from the instance settings row
# written by the setup wizard. cloud reads ANTHROPIC_API_KEY and PROXY_SELLER_API_KEY from here.
LINKEDGROW_EDITION=self-hosted

# Where the per-account Chrome profiles live.
PROFILE_ROOT=profiles

# Concurrent browsers. 2 fits a 4 GB box; 12 needs 16 GB.
WORKER_SLOTS=2

# Optional. Path to a Chromium or Chrome binary. Unset means the Google Chrome channel (amd64 only).
CHROME_PATH=
